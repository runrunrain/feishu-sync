{
  "name": "feishu-sync",
  "private": true,
  "version": "0.3.13",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"npm run server:dev\" \"npm run dev\"",
    "build": "vite build",
    "build:all": "npm run build && npm run server:build",
    "server:dev": "node node_modules/tsx/dist/cli.mjs watch server/src/index.ts",
    "server:build": "npm run build --prefix server",
    "server:start": "node server/dist/index.js",
    "electron:build": "npm run electron:build:main && npm run electron:build:preload",
    "electron:build:main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --external:../server/dist/index.js --outfile=dist-electron/main.cjs --banner:js=\"var __dirname = require('path').dirname(__filename);\"",
    "electron:build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "dev:desktop": "npm run server:build && npm run electron:build && concurrently -k -n VITE,ELECTRON \"npm run dev\" \"npm run electron:dev\"",
    "desktop:dist:win:x64": "node scripts/build-desktop-target.cjs --platform win32 --arch x64",
    "desktop:dist:mac:x64": "node scripts/build-desktop-target.cjs --platform darwin --arch x64",
    "desktop:dist:mac:arm64": "node scripts/build-desktop-target.cjs --platform darwin --arch arm64",
    "desktop:dist:mac:x64:release": "cross-env DESKTOP_MAC_SIGNING=release node scripts/build-desktop-target.cjs --platform darwin --arch x64",
    "desktop:dist:mac:arm64:release": "cross-env DESKTOP_MAC_SIGNING=release node scripts/build-desktop-target.cjs --platform darwin --arch arm64"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@hono/node-server": "^1.14.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.8",
    "@vitejs/plugin-react": "^4.7.0",
    "better-sqlite3": "^11.9.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^26.8.1",
    "electron-updater": "^6.6.2",
    "esbuild": "^0.28.0",
    "hono": "^4.7.0",
    "lucide-react": "^1.18.0",
    "openai": "^4.89.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.5"
  }
}
