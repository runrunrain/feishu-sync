+    expect(scan.untrusted).toBe(false);
+    expect(scan.runs).toHaveLength(1);
+    expect(scan.runs[0]).toMatchObject({ taskId: 'task-abc', rootPid: 5000, pgid: 5000, rootIdentityToken: 'darwin:111:222', leaderPid: 4100 });
