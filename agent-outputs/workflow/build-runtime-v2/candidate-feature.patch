+      // 写工具真实可用（受分配保护的服务端裁决链）
+      bridge.send({ jsonrpc: '2.0', id: 4, method: 'tools/call', params: { name: 'kb_write_doc', arguments: { path: 'combat/f02.md', title: 'F02', markdown: '# f02\n同连接刷新后写入。', sources: ['tokA'], summary: 'f02', operationId: 'op-f02' } } });
