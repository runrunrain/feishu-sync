+  try {
+    skillStat = fs.lstatSync(skillPath);
+  } catch {
+    issues.push(`workflow skill 文件缺失（${skillPath}）——child 规则未冻结，拒绝派发`);
+  }
+  if (skillStat !== null) {
+    if (skillStat.isSymbolicLink()) {
+      issues.push(`workflow skill 是符号链接（${skillPath}）——未哈希的可变入口，拒绝派发`);
+    } else if (!skillStat.isFile()) {
