+        issues.push(`workflow skill 内容与冻结 workflowRevision 不一致（${skillPath}，冻结 ${refs.workflowSkill.sha256.slice(0, 12)}，当前 ${skillHash.slice(0, 12)}）——child 将读到被改规则而回执仍绑旧版本，拒绝派发`);
+      }
+    }
+  }
