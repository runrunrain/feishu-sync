+  // executeLeaderPublishRequest 的最小 entry（真实入口所需字段）
+  const updates: Array<Record<string, unknown>> = [];
+  const entry: Record<string, unknown> = {
+    id: buildId,
+    buildState: state,
+    checkpointReady: false, // 检查点落盘不在本测试面
+    leaderPipelineContext: {
