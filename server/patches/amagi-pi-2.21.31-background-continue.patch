new file mode 100644
index 0000000..af294e6
--- /dev/null
+++ b/tests/ev-20261102-shutdown-queued-recovery.test.mjs
@@ -0,0 +1,44 @@
+import assert from 'node:assert/strict';
+import { after, test } from 'node:test';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+const root = fs.mkdtempSync(path.join(os.tmpdir(), 'amagi-shutdown-queue-'));
+process.env.AMAGI_CONTRACT_ROOT = path.join(root, 'v2-store');
+process.env.AMAGI_DATA_DIR = path.join(root, 'data');
+
+const { registry } = await import('../extensions/amagi-core/task-registry.ts');
+const { submitTaskKernel, getTaskKernel } = await import('../extensions/amagi-core/task-service.ts');
+const { tryOccupy, waitForGrant, release, _setAdmissionCapacityForTest, resetAdmissionForTest } = await import('../extensions/amagi-core/admission.ts');
+const { cleanupChildrenOnShutdown } = await import('../extensions/amagi-core/task-run.ts');
+
+after(() => {
+  registry.setShuttingDown(false);
+  resetAdmissionForTest();
+  fs.rmSync(root, { recursive: true, force: true });
+});
+
+test('shutdown closes queued tasks before releasing slots and persists no-process proof', async () => {
+  _setAdmissionCapacityForTest(1);
+  assert.equal(tryOccupy('busy-holder'), 'running');
+  const ids = ['shutdown-waiting-1', 'shutdown-waiting-2'];
+  for (const taskId of ids) {
+    const submit = await submitTaskKernel({ taskId, agent: 'luban', assignment: 'queued shutdown fixture', cwd: root, mode: 'background' });
+    assert.equal(submit.ok, true, submit.message);
+    assert.equal(tryOccupy(taskId), 'queued');
+  }
+  const waits = ids.map((id) => waitForGrant(id));
+  registry.setShuttingDown(true);
+  await cleanupChildrenOnShutdown(10);
+  release('busy-holder');
+  assert.deepEqual(await Promise.all(waits), ['cancelled', 'cancelled']);
+  for (const taskId of ids) {
+    const run = getTaskKernel().get(taskId)?.run;
+    assert.equal(run?.execution, 'cancelled');
+    assert.equal(run?.processState, 'exited');
+    assert.equal(run?.launchIntent, undefined);
+    const disk = JSON.parse(fs.readFileSync(path.join(root, 'v2-store', taskId, 'current.json'), 'utf8'));
+    assert.equal(disk.processState, 'exited');
+  }
+});
