 export async function cleanupChildrenOnShutdown(graceMs = 2000, deps: ShutdownCleanupDeps = {}): Promise<void> {
+	// Release of a running child promotes the next admission waiter. Fence every
+	// queued task first, including a waiter that was just promoted but has not
+	// entered its continuation yet. Otherwise shutdown can grant-start/spawn new
+	// children while it is trying to close the old ones.
+	const waiting = registry.list().filter((task) => task.status === "queued");
+	for (const task of waiting) cancelTask(task.taskId, "session shutdown before child cleanup");
+	for (const task of waiting) {
+		// No launch intent is a durable proof that this task never reached spawn.
+		// Persist the physical closure too; the next Leader's residual guard must
+		// not mistake the cancelled admission record for an untracked child.
+		const kernel = getTaskKernel();
+		const view = kernel.get(task.taskId);
+		if (!view || view.run.execution !== "cancelled" || view.run.launchIntent
+			|| view.run.processState !== "not-started") continue;
+		await kernel.applyQuiet({
+			type: "reconcile",
+			key: { ownerId: view.run.ownerId, taskId: task.taskId, revision: view.revision },
+			facts: [{ code: "shutdown-never-spawned", detail: "Queued task was cancelled before child cleanup; no launchIntent was granted" }],
+			disposition: "confirm-exited",
+		});
+	}
 	const running = registry.getRunningChildren();
 	const children = running.map(({ child }) => child);
 	for (let i = 0; i < running.length; i++) {
