{
  "name": "feishu-sync-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/build-agent-assets.mjs",
    "build:agent-assets": "node scripts/build-agent-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:corpus": "tsx scripts/audit-knowledge-base.ts",
    "backup:state": "tsx scripts/backup-operation-state.ts",
    "reconcile:dry-run": "tsx scripts/reconcile-knowledge-base.ts",
    "reconcile:apply": "tsx scripts/reconcile-apply.ts",
    "migrate:v5": "tsx scripts/run-migration-v5.ts",
    "amagi:refresh": "node scripts/refresh-amagi.mjs",
    "test:migrations": "vitest run tests/migration-v5.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "archiver": "^5.3.2",
    "better-sqlite3": "^12.11.1",
    "csv-parser": "^3.2.1",
    "exceljs": "^4.4.0",
    "hono": "^4.13.14",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.1",
    "openai": "^4.89.0",
    "smol-toml": "^1.9.1",
    "ssf": "^0.11.2",
    "unpdf": "1.9.1",
    "unzipper": "^0.10.14"
  },
  "devDependencies": {
    "@types/archiver": "^5.3.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/unzipper": "^0.10.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "zod": "^4.6.6"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  }
}
