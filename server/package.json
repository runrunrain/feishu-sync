{
  "name": "feishu-sync-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:corpus": "tsx scripts/audit-knowledge-base.ts",
    "backup:state": "tsx scripts/backup-operation-state.ts",
    "reconcile:dry-run": "tsx scripts/reconcile-knowledge-base.ts",
    "migrate:v5": "tsx scripts/run-migration-v5.ts",
    "test:migrations": "vitest run tests/migration-v5.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "better-sqlite3": "^11.9.0",
    "csv-parser": "^3.2.1",
    "hono": "^4.7.0",
    "openai": "^4.89.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.9"
  }
}
